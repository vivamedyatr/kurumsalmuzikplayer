<Window x:Class="KurumsalMuzikPlayer.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurumsal Müzik Player"
        SizeToContent="WidthAndHeight" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0C0B0A" Foreground="#F3EDE7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- İçerik 1040×610 tasarım boyutunda; pencere oranı sabit ölçeklenir (WindowFrame) -->
    <Viewbox x:Name="Scaler" Stretch="Uniform">
        <Grid x:Name="Design" Width="1040" Height="610" Background="{StaticResource Bg}" TextElement.FontFamily="{StaticResource Sans}">

            <!-- ===================== ÇALAR ===================== -->
            <Grid x:Name="PlayerScreen">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sol ray -->
                <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="20,20,14,14">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="21">KURUMSAL<Run Text="." Foreground="{StaticResource Vm}" /></TextBlock>
                            <TextBlock x:Name="WordmarkSub" Style="{StaticResource MonoText}" FontSize="9" Margin="1,6,0,22" />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StoreEyebrow" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="AccountText" FontWeight="Bold" FontSize="14" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Fg2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="BranchRun" /><Run x:Name="CodeRun" FontFamily="{StaticResource Mono}" />
                                </TextBlock>
                                <Border x:Name="StatusPill" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="1" Padding="8,3" Margin="0,10,0,0"
                                        BorderBrush="#4D7FD49B">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="StatusPillText" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Ok}" />
                                    </StackPanel>
                                </Border>
                                <DockPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="UpdatesBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Updates_Click"
                                              ToolTip="Açıkken akıştaki albümlerin bir kısmı ayda bir yenilenir (en fazla 5 albüm)." />
                                    <TextBlock Text="Aylık yeni müzik" FontSize="12.5" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Button Content="Akışı düzenle  ↗" Style="{StaticResource GhostButton}" Margin="0,12,0,0" Click="FlowEdit_Click"
                                        ToolTip="Kurumsal Müzik Net'te bu şubenin tarz akışını açar (akış şifresi istenir)." />
                                <TextBlock x:Name="VersionText" Style="{StaticResource MonoText}" FontSize="10" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="Nav">
                            <RadioButton x:Name="NavNow" GroupName="nav" IsChecked="True" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                                <DockPanel>
                                    <Path Data="{StaticResource IconNow}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Margin="0,0,12,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Çalıyor" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFlow" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                                <DockPanel>
                                    <Path Data="{StaticResource IconFlow}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Margin="0,0,12,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Bugünkü akış" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAnn" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                                <DockPanel>
                                    <Path Data="{StaticResource IconAnn}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Margin="0,0,12,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock x:Name="NavAnnBadge" DockPanel.Dock="Right" Style="{StaticResource MonoText}" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Anonslar" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavHistory" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                                <DockPanel>
                                    <Path Data="{StaticResource IconHistory}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Margin="0,0,12,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Geçmiş" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavArchive" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                                <DockPanel>
                                    <Path Data="{StaticResource IconArchive}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Margin="0,0,12,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock x:Name="NavArchiveBadge" DockPanel.Dock="Right" Style="{StaticResource MonoText}" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Arşiv" />
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Ana alan -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <!-- Albüm kapağından yayılan renk (YouTube Music gibi): kapak çok küçük çözülüp büyütülür, bulanık görünür -->
                    <Image x:Name="Ambient" Stretch="UniformToFill" VerticalAlignment="Top" Height="400" Margin="-80,-90,-80,0" Opacity="0.5"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#260C0B0A" Offset="0" />
                                <GradientStop Color="#BF0C0B0A" Offset="0.46" />
                                <GradientStop Color="#FF0C0B0A" Offset="0.68" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Çalıyor -->
                    <StackPanel x:Name="NowView" Margin="30,18,30,0">
                        <StackPanel Orientation="Horizontal" Height="24">
                            <TextBlock x:Name="DateText" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            <Border x:Name="ServiceChip" Style="{StaticResource Chip}">
                                <TextBlock x:Name="ServiceText" Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource Fg2}" />
                            </Border>
                            <Border x:Name="DownloadChip" Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DownloadText" Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource Fg}" />
                                    <Grid Width="46" Height="3" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <Border Background="#26F3EDE7" CornerRadius="1.5" />
                                        <Border x:Name="DownloadFill" Background="{StaticResource Fg2}" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NoticeChip" Style="{StaticResource Chip}" BorderBrush="#66E8913A" Visibility="Collapsed">
                                <TextBlock x:Name="NoticeText" FontSize="11.5" Foreground="{StaticResource Warn}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,18,0,0" Height="196">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Gölge efekt olmadan (yazılımla çizimde DropShadowEffect eski pikselleri silmiyordu): yumuşak koyu katmanlar -->
                            <Border CornerRadius="14" Margin="-10,6,-10,-22" Background="#26000000" />
                            <Border CornerRadius="10" Margin="-4,4,-4,-12" Background="#33000000" />
                            <Border CornerRadius="6" Background="{StaticResource Bg3}">
                                <Grid>
                                    <Border x:Name="CoverFallback" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <Rectangle x:Name="CoverGrain" Opacity="0.5" />
                                            <TextBlock x:Name="CoverFallbackText" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="26" LineHeight="26"
                                                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="14,0,14,14" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image x:Name="CoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="15" Height="15" VerticalAlignment="Center">
                                        <Ellipse x:Name="LiveHalo" Fill="#2EE4362D" />
                                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource Vm}" />
                                    </Grid>
                                    <TextBlock x:Name="LiveEyebrow" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Vm}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="GenreTitle" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="54" LineHeight="50"
                                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                <TextBlock FontSize="18" Margin="0,14,0,0" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="SongRun" FontWeight="SemiBold" /><Run x:Name="AlbumRun" Foreground="{StaticResource Fg2}" />
                                </TextBlock>
                                <TextBlock x:Name="NextText" FontSize="13" Foreground="{StaticResource Fg2}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,20,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#4A4542" Margin="0,0,6,0" />
                                <TextBlock Text="Çaldı" FontSize="11.5" Foreground="{StaticResource Fg2}" Margin="0,0,14,0" />
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{StaticResource Vm}" Margin="0,0,6,0" />
                                <TextBlock Text="Şimdi" FontSize="11.5" Foreground="{StaticResource Fg2}" Margin="0,0,14,0" />
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{StaticResource Fg}" Margin="0,0,6,0" />
                                <TextBlock Text="Sırada" FontSize="11.5" Foreground="{StaticResource Fg2}" />
                            </StackPanel>
                            <TextBlock Text="Bugünkü akış" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="ExtraBold" FontSize="17" />
                        </DockPanel>
                        <Grid Height="58">
                            <Grid x:Name="Strip" />
                            <Canvas x:Name="StripMarkLayer" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Height="22">
                            <Grid x:Name="StripHours" Margin="0,7,0,0" />
                            <Canvas x:Name="StripLabelLayer" IsHitTestVisible="False" />
                        </Grid>

                        <Grid Margin="0,12,0,0" Height="116">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AnnCardEyebrow" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="NextAnnTime" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" FontSize="22" Margin="0,8,0,0" />
                                    <TextBlock x:Name="NextAnnWhat" FontSize="12.5" Foreground="{StaticResource Fg2}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="RecentEyebrow" Style="{StaticResource Eyebrow}" />
                                    <ItemsControl x:Name="RecentList" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Bugünkü akış / Anonslar / Geçmiş / Arşiv: aynı başlık düzeni, içi kodda dolar -->
                    <DockPanel x:Name="PageView" Margin="30,22,24,0" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,6,14">
                            <TextBlock x:Name="PageEyebrow" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Vm}" />
                            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="34" Margin="0,6,0,0" />
                            <TextBlock x:Name="PageSub" FontSize="13" Foreground="{StaticResource Fg2}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,16">
                            <StackPanel x:Name="PageBody" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- Alt çubuk -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="48" Height="48">
                                <Border x:Name="BarThumbFallback" CornerRadius="4" />
                                <Border CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="BarThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="226">
                                <TextBlock x:Name="BarTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="BarSub" FontSize="12" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Grid Width="38" Height="38" ToolTip="Yayında. Mağaza yayını durdurulamaz; ses ayarı sağda.">
                                    <Ellipse Margin="-6,-2,-6,-10" Fill="#22E4362D" />
                                    <Ellipse x:Name="OnAir" Fill="{StaticResource Vm}" />
                                    <Ellipse Width="10" Height="10" Fill="White" />
                                </Grid>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Margin="14,0,0,0" VerticalAlignment="Center" Click="Next_Click"
                                        ToolTip="Sonraki şarkı">
                                    <Grid>
                                        <Path Data="{StaticResource IconSkip}" Width="18" Height="18" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock x:Name="SkipWait" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Fg3}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-8" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="PosText" Style="{StaticResource MonoText}" FontSize="10.5" Width="36" TextAlignment="Center" DockPanel.Dock="Left" />
                                <TextBlock x:Name="DurText" Style="{StaticResource MonoText}" FontSize="10.5" Width="36" TextAlignment="Center" DockPanel.Dock="Right" />
                                <Grid x:Name="ProgressTrack" Height="4" Margin="8,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource Track}" CornerRadius="2" />
                                    <Border x:Name="ProgressFill" Background="{StaticResource Fg}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="LiveTag" BorderBrush="{StaticResource Vm}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="LiveTagText" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Vm}" />
                            </Border>
                            <Path Data="{StaticResource IconSpeaker}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Fg2}" StrokeThickness="2"
                                  Margin="14,0,10,0" VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="110" VerticalAlignment="Center" ValueChanged="Volume_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== ŞUBE GİRİŞİ ===================== -->
            <Grid x:Name="LoginScreen" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>
                <Grid ClipToBounds="True">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3AE4362D" Offset="0" />
                                <GradientStop Color="#000C0B0A" Offset="0.7" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="LoginGrain" Opacity="0.35" />
                    <StackPanel VerticalAlignment="Center" Margin="56,0,40,0">
                        <TextBlock FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="40">KURUMSAL<Run Text="." Foreground="{StaticResource Vm}" /></TextBlock>
                        <TextBlock x:Name="LoginSub" Style="{StaticResource MonoText}" FontSize="11" Margin="2,8,0,0" />
                        <TextBlock Text="Mağazanızın radyosu internet olmasa da çalar." FontSize="20" FontWeight="SemiBold" Margin="0,40,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Kurumsal Müzik Net kullanıcı adınız, şifreniz ve bu mağazanın şube adıyla bir kez giriş yapın; gerisini program yapar."
                                   FontSize="13.5" Foreground="{StaticResource Fg2}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />
                        <Border x:Name="LoginNoticeBox" Margin="0,24,0,0" Padding="12,10" CornerRadius="8" Background="#1FE8913A" BorderBrush="#66E8913A"
                                BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="LoginNotice" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12.5" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="48,0">
                        <TextBlock x:Name="LoginEyebrow" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Şube girişi" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="28" Margin="0,6,0,22" />
                        <TextBlock Text="Kullanıcı adı" FontSize="12" Foreground="{StaticResource Fg2}" />
                        <TextBox x:Name="UserBox" />
                        <TextBlock Text="Şifre" FontSize="12" Foreground="{StaticResource Fg2}" />
                        <PasswordBox x:Name="PassBox" />
                        <TextBlock Text="Şube adı" FontSize="12" Foreground="{StaticResource Fg2}" />
                        <TextBox x:Name="BranchBox" />
                        <Button x:Name="LoginButton" Content="Giriş yap" IsDefault="True" Style="{StaticResource RedButton}" Margin="0,6,0,0" Click="Login_Click" />
                        <TextBlock x:Name="LoginError" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12.5" />
                        <TextBlock x:Name="LoginVersion" Style="{StaticResource MonoText}" FontSize="10" Margin="0,26,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== YAYIN DURDU (hizmet süresi) ===================== -->
            <Grid x:Name="ExpiredScreen" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                    <TextBlock FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="24">KURUMSAL<Run Text="." Foreground="{StaticResource Vm}" /></TextBlock>
                    <TextBlock Text="Yayın durdu" FontFamily="{StaticResource Wide}" FontStretch="Expanded" FontWeight="Black" FontSize="40" Margin="0,30,0,0" />
                    <TextBlock x:Name="ExpiredText" FontSize="15" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22" />
                    <TextBlock Text="Viva Medya · vivamedya.com" Style="{StaticResource MonoText}" Margin="0,28,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
