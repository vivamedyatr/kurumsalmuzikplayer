<Window x:Class="KurumsalMuzikPlayer.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurumsal Müzik Player"
        Width="760" Height="460" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0D" Foreground="#F2EFE9"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8C8983" />
        <SolidColorBrush x:Key="Red" Color="#E3262B" />
        <SolidColorBrush x:Key="Line" Color="#2A2A30" />
        <SolidColorBrush x:Key="Warn" Color="#E8B04A" />
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2EFE9" />
            <Setter Property="Background" Value="#18181C" />
            <Setter Property="BorderBrush" Value="#34343B" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F2EFE9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Üstteki sekmeler: sade yazı, seçili olan beyaz -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8C8983" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F2EFE9" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F2EFE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Foreground" Value="#F2EFE9" />
            <Setter Property="Background" Value="#141417" />
            <Setter Property="BorderBrush" Value="#34343B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="#F2EFE9" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="#F2EFE9" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8C8983" />
        </Style>
        <Style x:Key="Scroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,16,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst: yayında + saat; sağda sekmeler -->
        <DockPanel Grid.Row="0">
            <StackPanel x:Name="Tabs" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabNow" Content="ÇALIYOR" GroupName="tab" IsChecked="True" Style="{StaticResource Tab}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabHistory" Content="GEÇMİŞ" GroupName="tab" Style="{StaticResource Tab}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabAnn" Content="ANONSLAR" GroupName="tab" Style="{StaticResource Tab}" Checked="Tab_Checked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource Red}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LiveText" Text="YAYINDA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="Clock" Text="--:--" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Çalar -->
        <Grid x:Name="PlayerView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="140" Height="140">
                    <!-- Kapak yoksa plak; ortası tarzın rengi -->
                    <Ellipse>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1E1E22" Offset="0.3" />
                                <GradientStop Color="#2B2B30" Offset="0.62" />
                                <GradientStop Color="#141416" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="VinylLabel" Width="46" Height="46" Fill="{StaticResource Red}" />
                    <Ellipse Width="6" Height="6" Fill="#0B0B0D" />
                    <Border x:Name="CoverBox" CornerRadius="4" Visibility="Collapsed" ClipToBounds="True">
                        <Image x:Name="CoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GenreText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Red}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TitleText" Text="—" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                    <TextBlock x:Name="SubText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Şarkı ilerlemesi (sadece bilgi) -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ProgressTrack" Height="3" Background="{StaticResource Line}" VerticalAlignment="Center">
                    <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Fill="{StaticResource Red}" />
                </Border>
                <TextBlock x:Name="TimesText" Grid.Column="1" Text="0:00 / 0:00" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="12,0,0,0" />
            </Grid>

            <!-- Ses ve sonraki -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Sonraki ›" Style="{StaticResource FlatButton}" Click="Next_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ses" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="VolumeSlider" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" ValueChanged="Volume_ValueChanged" />
                    <TextBlock x:Name="VolumeText" Width="32" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Durum -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,3" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock x:Name="LibraryText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ExperimentText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Geçmiş -->
        <ScrollViewer x:Name="HistoryView" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Scroll}" Margin="0,12,0,4">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding At}" FontFamily="Consolas" FontSize="12" Foreground="#8C8983" />
                            <StackPanel Grid.Column="1">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Tag, Mode=OneWay}" Foreground="#E3262B" FontWeight="SemiBold" FontSize="11" />
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#8C8983" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Anons akışı (salt okunur) -->
        <ScrollViewer x:Name="AnnView" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Scroll}" Margin="0,12,0,4">
            <StackPanel>
                <TextBlock x:Name="AnnNext" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                <ItemsControl x:Name="AnnPlans">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="#E3262B" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AnnUpcoming" Foreground="#8C8983" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Şube girişi -->
        <Grid x:Name="LoginView" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Şube girişi" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Kurumsal Müzik Net kullanıcı adınız, şifreniz ve bu mağazanın şube adı."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="LoginNotice" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="KULLANICI ADI" Style="{StaticResource Label}" />
                <TextBox x:Name="UserBox" />
                <TextBlock Text="ŞİFRE" Style="{StaticResource Label}" />
                <PasswordBox x:Name="PassBox" />
                <TextBlock Text="ŞUBE ADI" Style="{StaticResource Label}" />
                <TextBox x:Name="BranchBox" />
                <Button x:Name="LoginButton" Content="Giriş yap" IsDefault="True" Style="{StaticResource FlatButton}"
                        Background="#E3262B" BorderBrush="#E3262B" FontWeight="SemiBold" Padding="18,9" Margin="0,4,0,0" Click="Login_Click" />
                <TextBlock x:Name="LoginError" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- Yayın durdu (hizmet süresi doldu) -->
        <Grid x:Name="ExpiredView" Grid.Row="1" Visibility="Collapsed">
            <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Yayın durdu" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="ExpiredText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Gün bandı: akışın saat dilimleri (sadece görüntü) -->
        <Grid x:Name="DayBandBox" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DayBand" ClipToBounds="True" />
            <Canvas x:Name="DayMarker" IsHitTestVisible="False">
                <Rectangle x:Name="NowLine" Width="2" Height="22" Fill="#F2EFE9" />
            </Canvas>
            <Grid x:Name="DayHours" Grid.Row="1" Margin="0,2,0,0" />
        </Grid>

        <!-- Alt -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}" />
            <TextBlock DockPanel.Dock="Left" FontSize="11">
                <Hyperlink NavigateUri="https://vivamedya.com" RequestNavigate="Link_RequestNavigate"
                           Foreground="{StaticResource Muted}" TextDecorations="{x:Null}">by Viva Medya</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="BranchText" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0" />
        </DockPanel>
    </Grid>
</Window>
