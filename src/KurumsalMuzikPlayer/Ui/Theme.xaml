<!-- Kurumsal Müzik tasarım dili (web: kurumsalmuzik/src/app/globals.css, docs/tasarim/yayin-ekrani.html) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Renkler -->
    <Color x:Key="BgColor">#0C0B0A</Color>
    <SolidColorBrush x:Key="Bg" Color="#0C0B0A" />
    <SolidColorBrush x:Key="Bg2" Color="#141211" />
    <SolidColorBrush x:Key="Bg3" Color="#1D1A18" />
    <SolidColorBrush x:Key="Rail" Color="#0A0908" />
    <SolidColorBrush x:Key="BarBg" Color="#0E0D0C" />
    <SolidColorBrush x:Key="Line" Color="#2A2623" />
    <SolidColorBrush x:Key="Fg" Color="#F3EDE7" />
    <SolidColorBrush x:Key="Fg2" Color="#A69D94" />
    <SolidColorBrush x:Key="Fg3" Color="#6A625B" />
    <SolidColorBrush x:Key="Vm" Color="#E4362D" />
    <SolidColorBrush x:Key="VmSoft" Color="#24E4362D" />
    <SolidColorBrush x:Key="Warn" Color="#E8913A" />
    <SolidColorBrush x:Key="Ok" Color="#7FD49B" />
    <SolidColorBrush x:Key="Track" Color="#1FF3EDE7" />

    <!-- Yazı tipleri (programın içinde; SIL OFL) -->
    <FontFamily x:Key="Sans">pack://application:,,,/Fonts/#Archivo</FontFamily>
    <!-- WPF Archivo'nun genişliklerini tek ailede toplar: geniş/dar kesim FontStretch ile seçilir (Expanded, SemiCondensed). -->
    <FontFamily x:Key="Wide">pack://application:,,,/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="Narrow">pack://application:,,,/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>

    <!-- Küçük büyük harfli başlık (web .eyebrow) -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Narrow}" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Fg3}" />
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Fg3}" />
    </Style>

    <!-- Çip (web .chip) -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BorderBrush" Value="#24F3EDE7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#590C0B0A" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Kart -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Sol menü öğesi -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Box" CornerRadius="8" Background="Transparent" Padding="10,9">
                            <ContentPresenter />
                        </Border>
                        <Rectangle x:Name="Mark" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Vm}" HorizontalAlignment="Left"
                                   Margin="-14,9,0,9" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Düğmeler -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Fg2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource Vm}" />
        <Setter Property="BorderBrush" Value="{StaticResource Vm}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Sol raydaki küçük metin düğmeleri (Destek, Çıkış yap) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alt çubuktaki yuvarlak duraklat / devam düğmesi -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Vm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Halo" Margin="-6,-2,-6,-10" Fill="#22E4362D" />
                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Halo" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Fg3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aylık yeni müzik anahtarı -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="30" Height="17">
                        <Border x:Name="Track" CornerRadius="8.5" Background="#3A3532" />
                        <Ellipse x:Name="Knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Vm}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ses kaydırıcısı (web .vol) -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="12" Height="12" Fill="White" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FillRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource FillRepeat}" Background="{StaticResource Fg2}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource FillRepeat}" Background="{StaticResource Track}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThumbStyle}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Giriş alanları -->
    <Style x:Key="Field" TargetType="Control">
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,5,0,14" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>

    <!-- Kaydırma çubuğu: ince, koyu -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#3A3532" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simgeler (24×24, çizgi) -->
    <Geometry x:Key="IconNow">M12,3 A9,9 0 1 1 11.99,3 Z M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>
    <Geometry x:Key="IconFlow">M5,5 H19 A2,2 0 0 1 21,7 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V7 A2,2 0 0 1 5,5 Z M3,10 H21 M8,3 V7 M16,3 V7</Geometry>
    <Geometry x:Key="IconAnn">M4,10 V14 H8 L14,19 V5 L8,10 Z M18,9 A4,4 0 0 1 18,15</Geometry>
    <Geometry x:Key="IconHistory">M12,3 A9,9 0 1 1 11.99,3 Z M12,7 V12 L15,14</Geometry>
    <Geometry x:Key="IconArchive">M4,7 H20 M4,12 H20 M4,17 H14</Geometry>
    <Geometry x:Key="IconSpeaker">M4,10 V14 H8 L14,19 V5 L8,10 Z M17,8 A5,5 0 0 1 17,16</Geometry>
    <Geometry x:Key="IconSkip">M6,5 L15,12 L6,19 Z M16,5 H18 V19 H16 Z</Geometry>
    <Geometry x:Key="IconPause">M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z</Geometry>
    <Geometry x:Key="IconPlay">M8,4.5 L19.5,12 L8,19.5 Z</Geometry>
</ResourceDictionary>
